# ══════════════════════════════════════════════════════
# CRAG Expert System — 环境变量配置模板 v2.0
# 复制此文件为 .env 并填入真实密钥，勿提交 .env 到 Git
# ══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
APP_ENV=development           # development / production
LOG_LEVEL=INFO

# ── LLM（DeepSeek / OpenAI 兼容）──────────────────────
OPENAI_API_KEY="your-deepseek-api-key"
OPENAI_API_BASE="https://api.deepseek.com"
OPENAI_MODEL="deepseek-chat"
OPENAI_MAX_TOKENS=4096

# ── Embedding ─────────────────────────────────────────
EMBEDDING_PROVIDER="api"
EMBEDDING_API_BASE="https://api.siliconflow.cn/v1"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="BAAI/bge-m3"

# ── Tavily 联网搜索（可选）────────────────────────────
TAVILY_API_KEY=""

# ── LangSmith 可观测（可选）──────────────────────────
LANGCHAIN_API_KEY=""
LANGSMITH_API_KEY=""
LANGCHAIN_PROJECT="crag-expert-system"

# ══════════════════════════════════════════════════════
# Phase 2 新增：数据库 & 缓存 & 认证
# ══════════════════════════════════════════════════════

# ── PostgreSQL（可选，不配置则无历史记录和用户系统）──
# 本地开发：postgresql+asyncpg://crag:cragpassword@localhost:5432/crag
# Docker:   postgresql+asyncpg://crag:cragpassword@postgres:5432/crag
DATABASE_URL=""

# ── Redis（可选，不配置则无缓存和限流）────────────────
# 本地开发：redis://localhost:6379/0
# Docker:   redis://redis:6379/0
REDIS_URL=""

# ── JWT 认证 ──────────────────────────────────────────
# 生产环境务必替换为随机强密钥（≥32字符）
JWT_SECRET_KEY="change-me-in-production-32chars!!"
JWT_EXPIRE_MINUTES=1440       # 24小时

# ── 功能开关 ──────────────────────────────────────────
REQUIRE_AUTH=false            # true 时所有 /chat /documents 需要登录
CACHE_ENABLED=true            # false 时禁用 Redis 问答缓存
CACHE_TTL_SECONDS=3600        # 缓存过期时间（秒）
RATE_LIMIT_PER_MINUTE=20      # 每 IP 每分钟最多问答次数

# ── CRAG 调优 ─────────────────────────────────────────
LOCAL_FIRST_MODE=true
AUTO_LOCAL_SCORE_THRESHOLD=0.55
VECTOR_STORE=faiss

# Kafka document-change consumer is provided by sync-service. Keep this blank
# unless a Kafka cluster is available.
KAFKA_BOOTSTRAP_SERVERS=""
KAFKA_DOCUMENT_TOPIC="rag-document-change"
KAFKA_DOCUMENT_DLQ_TOPIC="rag-document-dlq"

# Optional CDC source: document metadata written here is captured by Canal.
MYSQL_CDC_ENABLED=false
MYSQL_CDC_DATABASE_URL=""

# Local development emits no telemetry by default; production uses an OTLP collector.
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=""
