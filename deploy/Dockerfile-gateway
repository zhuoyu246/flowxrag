FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
COPY api/proto/ragpb/ ./api/proto/ragpb/
COPY gateway/ ./gateway/
RUN go mod download && CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /gateway ./gateway/cmd/gateway

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /gateway /gateway
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/gateway"]
